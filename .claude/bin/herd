#!/bin/bash
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:$HOME/AppData/Local/Microsoft/WinGet/Links:$HOME/AppData/Local/Programs/herdr-core:$HOME/AppData/Local/agy/bin:$PATH"
ROOT=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
HERE=$(git rev-parse --show-toplevel)
BASE=$(git -C "$HERE" rev-parse --abbrev-ref HEAD)
cmd="${1:-help}"
[ $# -gt 0 ] && shift

helpers() { git -C "$ROOT" worktree list | grep -c ' \[herd/'; }

remove() {
  name="$1"
  wt="$ROOT/.claude/worktrees/$name"
  hc kill "$name" >/dev/null 2>&1
  if command -v powershell.exe >/dev/null; then
    powershell.exe -NoProfile -NonInteractive -Command "\$w='$wt'; \$b=\$w -replace '/','\\'; Get-CimInstance Win32_Process | Where-Object { \$_.CommandLine -and (\$_.CommandLine.Contains(\$w + '/') -or \$_.CommandLine.Contains(\$b + '\\')) } | ForEach-Object { Stop-Process -Id \$_.ProcessId -Force -ErrorAction SilentlyContinue }" >/dev/null 2>&1
  else
    pkill -f "$wt/" 2>/dev/null
  fi
  for _ in 1 2 3 4 5 6; do
    git -C "$ROOT" worktree remove --force "$wt" 2>/dev/null && break
    sleep 2
  done
  rm -rf "$wt" 2>/dev/null
  git -C "$ROOT" worktree prune
  rm -rf "$ROOT/target/herd-$name" "$ROOT/target/herd-$name"-* 2>/dev/null
  rm -f "$ROOT/.git/herd-lanes/$name"
  [ -d "$wt" ] && { echo "could not delete $wt; a process still holds it" >&2; exit 1; }
  git -C "$HERE" branch -d "herd/$name"
}

case "$cmd" in
  new)
    name="${1:?name}"; shift
    cli="${HERD_CLI:-claude}"
    model=""
    lane=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --model) model="$2"; shift 2 ;;
        --cli) cli="$2"; shift 2 ;;
        --lane) lane="$2"; shift 2 ;;
        *) break ;;
      esac
    done
    task="${1:?task}"
    if [ "$cli" = "agy" ]; then
      case "${model:-flash}" in
        haiku|flash_lite|fast) model="gemini-3.8-flash-low" ;;
        sonnet|flash) model="gemini-3.8-flash-high" ;;
        opus|pro) model="gemini-4-neon-high" ;;
        fable|xhigh) model="gemini-4-neon-xhigh" ;;
      esac
    else
      model="${model:-sonnet}"
    fi
    [ "$(helpers)" -ge "${HERD_MAX:-4}" ] && { echo "already $(helpers) helpers; land or remove one first (HERD_MAX=${HERD_MAX:-4})" >&2; exit 1; }
    wt="$ROOT/.claude/worktrees/$name"
    git -C "$ROOT" worktree add -q -b "herd/$name" "$wt" "$(git -C "$HERE" rev-parse HEAD)" || exit 1
    grep -qx '/.cargo/' "$ROOT/.git/info/exclude" || echo '/.cargo/' >> "$ROOT/.git/info/exclude"
    mkdir -p "$wt/.cargo"
    wrapper=$(command -v sccache || echo sccache); command -v cygpath >/dev/null && wrapper=$(cygpath -m "$wrapper")
    printf '[build]\nrustc-wrapper = "%s"\nbuild-dir = "%s/target/herd-%s"\n' "$wrapper" "$ROOT" "$name" > "$wt/.cargo/config.toml"
    printf '{\n  "enabledPlugins": { "rust-analyzer-lsp@claude-plugins-official": false }\n}\n' > "$wt/.claude/settings.local.json"
    reach="${HC_TERMINAL_ID:-}"
    mkdir -p "$ROOT/.git/herd-lanes"
    if [ -n "$lane" ]; then printf '%s\n' "$lane" | tr ',' '\n' > "$ROOT/.git/herd-lanes/$name"; else rm -f "$ROOT/.git/herd-lanes/$name"; fi
    prompt="You work alone in the git worktree $wt on branch herd/$name. Only touch this worktree. Follow the ship skill. Commit only on branch herd/$name at stable points, no co-author; never push, merge or touch main. Do not start other hc agents. Builds take a machine-wide lock, so cargo may wait for another helper's build; that is normal, do not cancel it. Task: $task"
    [ -n "$lane" ] && prompt="$prompt Your lane, the only paths you may change: $lane. If the clean fix needs a file outside it, stop and report instead of editing it."
    [ -n "$reach" ] && prompt="$prompt Report the result or any blocker with: hc send $reach \"<text>\""
    if [ "$cli" = "agy" ]; then
      python3 -c '
import json, os, sys
from pathlib import Path
p = Path.home() / ".gemini" / "antigravity-cli" / "settings.json"
wt = os.path.normpath(sys.argv[1])
data = json.loads(p.read_text(encoding="utf-8")) if p.exists() else {}
tw = data.setdefault("trustedWorkspaces", [])
if not any(os.path.normcase(os.path.normpath(x)) == os.path.normcase(wt) for x in tw):
    tw.append(wt)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
' "$(command -v cygpath >/dev/null && cygpath -w "$wt" || echo "$wt")" 2>/dev/null || true
      hc run --bg --json --name "$name" --cwd "$wt" --label herd=1 -- agy --model "$model" --mode "${HERD_MODE:-auto}" --dangerously-skip-permissions -i "$prompt" | jq -c '{address, name}'
    else
      hc run --bg --json --name "$name" --cwd "$wt" --label herd=1 -- claude --model "$model" --permission-mode "${HERD_MODE:-auto}" "$prompt" | jq -c '{address, name}'
      for _ in $(seq 1 30); do
        screen=$(hc read --lines 30 "$name" 2>/dev/null)
        case "$screen" in
          *"trust this folder"*) hc keys "$name" down enter >/dev/null; break ;;
          *"turn on Code Mode"*) hc keys "$name" enter >/dev/null ;;
          *"$name"*"Task:"*) break ;;
        esac
        perl -e 'select(undef,undef,undef,0.5)'
      done
    fi
    ;;
  ls)
    git -C "$ROOT" worktree list | grep 'herd/' || echo "no helpers"
    ;;
  status)
    for wt in $(git -C "$ROOT" worktree list --porcelain | awk '/^worktree /{w=$2} /^branch refs\/heads\/herd\//{print w}'); do
      name=$(basename "$wt")
      ahead=$(git -C "$ROOT" rev-list --count "$BASE..herd/$name")
      dirty=$(git -C "$wt" status --porcelain | grep -vc '^??')
      last=$(hc read --lines 40 "$name" 2>/dev/null | grep -vE '^\s*$|─|^❯|auto mode|Update available|Tip:|\[hc\]' | tail -1 | sed 's/^ *//' | cut -c1-110)
      printf '%-10s %2s commits  %2s uncommitted  %s\n' "$name" "$ahead" "$dirty" "${last:-(not running)}"
    done
    [ "$(helpers)" = 0 ] && echo "no helpers"
    command -v powershell.exe >/dev/null && echo "free RAM $(powershell.exe -NoProfile -c '[math]::Round((Get-CimInstance Win32_OperatingSystem).FreePhysicalMemory/1MB,1)' | tr -d '\r') GB"
    ;;
  land)
    name="${1:?name}"
    branch="herd/$name"
    wt="$ROOT/.claude/worktrees/$name"
    cd "$HERE" || exit 1
    "$ROOT/.claude/bin/sync" | tail -1
    [ "$(git rev-list --count "$BASE..$branch")" -gt 0 ] || { echo "$branch has nothing to land" >&2; exit 1; }
    [ -z "$(git -C "$wt" status --porcelain | grep -v '^??')" ] || { echo "$name has uncommitted changes:" >&2; git -C "$wt" status --short >&2; exit 1; }
    if [ -s "$ROOT/.git/info/personal" ]; then
      hits=$(git diff "$BASE...$branch" | grep -nE "^\+.*($(paste -sd'|' "$ROOT/.git/info/personal"))")
      [ -n "$hits" ] && { echo "personal data in the diff:" >&2; echo "$hits" | head -5 >&2; exit 1; }
    else
      echo "warning: no .git/info/personal (one pattern per line), personal data not checked" >&2
    fi
    hits=$(git diff "$BASE...$branch" -- src | grep -nE '^\+\s*//[^/!]')
    [ -n "$hits" ] && { echo "code comments in the diff:" >&2; echo "$hits" | head -5 >&2; exit 1; }
    if [ -s "$ROOT/.git/herd-lanes/$name" ] && [ -z "${HERD_LANE_OK:-}" ]; then
      outside=""
      for f in $(git diff --name-only "$BASE...$branch"); do
        inside=""
        while IFS= read -r glob; do
          [ -n "$glob" ] && [[ "$f" == $glob ]] && { inside=1; break; }
        done < "$ROOT/.git/herd-lanes/$name"
        [ -z "$inside" ] && outside="$outside $f"
      done
      [ -n "$outside" ] && { echo "outside the lane of $name (HERD_LANE_OK=1 to land anyway):$outside" >&2; exit 1; }
    fi
    git diff --quiet && git diff --cached --quiet || { echo "$BASE has uncommitted changes; commit them first" >&2; exit 1; }
    git merge --no-ff --no-commit "$branch" >/dev/null 2>&1
    conflicts=$(git diff --name-only --diff-filter=U)
    [ -n "$conflicts" ] && { echo "conflicts, resolve them, then commit and herd rm $name:" >&2; echo "$conflicts" >&2; exit 1; }
    git commit -q -m "Merge $branch: $(git log -1 --format=%s "$branch")"
    [ -f "$ROOT/.git/MERGE_HEAD" ] && { echo "the commit was refused (gate above); fix, then commit and herd rm $name" >&2; exit 1; }
    git log --oneline -1
    remove "$name"
    "$ROOT/.claude/bin/sync" | tail -1
    ;;
  rm)
    remove "${1:?name}"
    ;;
  *)
    echo "herd new <name> [--model m] [--lane glob,glob] <task> | herd ls | herd status | herd land <name> | herd rm <name>"
    ;;
esac
