#!/usr/bin/env python3
"""Regenerates src/core/headless/render/states.rs from a Minecraft server jar's data generator report: every block with
the first id of its states and its properties, so a block state id decodes to a name and property values.

render-blocks [server.jar | reports dir]   default: the test server's 26.3 jar
"""
import json
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "src" / "core" / "headless" / "render" / "states.rs"
DEFAULT_JAR = Path(tempfile.gettempdir()) / "manycraft-testserver" / "26.3" / "server.jar"


def report(source):
    if source.is_dir():
        return json.loads((source / "blocks.json").read_text(encoding="utf-8"))
    with tempfile.TemporaryDirectory() as work:
        subprocess.run(["java", "-DbundlerMainClass=net.minecraft.data.Main", "-jar", str(source), "--reports", "--output", str(Path(work) / "out")], cwd=work, check=True, stdout=subprocess.DEVNULL)
        return json.loads((Path(work) / "out" / "reports" / "blocks.json").read_text(encoding="utf-8"))


def main():
    source = Path(sys.argv[1]) if len(sys.argv) > 1 else DEFAULT_JAR
    blocks = report(source)
    properties = []
    index = {}
    rows = []
    total = 0
    for name, block in sorted(blocks.items(), key=lambda b: min(s["id"] for s in b[1]["states"])):
        props = block.get("properties", {})
        keys = sorted(props)
        first = min(s["id"] for s in block["states"])
        for state in block["states"]:
            offset = 0
            for key in keys:
                offset = offset * len(props[key]) + props[key].index(state["properties"][key])
            if first + offset != state["id"]:
                sys.exit(f"{name}: state {state['id']} is not in sorted property order")
        ids = []
        for key in keys:
            entry = (key, tuple(props[key]))
            if entry not in index:
                index[entry] = len(properties)
                properties.append(entry)
            ids.append(index[entry])
        rows.append((first, name.removeprefix("minecraft:"), ids))
        total = max(total, max(s["id"] for s in block["states"]) + 1)
    lines = [
        "//! Generated by `.claude/bin/render-blocks` from the Minecraft 26.3 data generator's blocks report. Do not edit.",
        "",
        "/// How many block states there are.",
        f"pub const STATES: u32 = {total};",
        "",
        "/// Every property a block has: its name and values, in the order the game counts them.",
        "pub const PROPERTIES: &[(&str, &[&str])] = &[",
    ]
    for key, values in properties:
        lines.append(f"    ({json.dumps(key)}, &[{', '.join(json.dumps(v) for v in values)}]),")
    lines += ["];", "", "/// Every block by its first state id: its name and its properties as indices into [`PROPERTIES`], in id order.", "pub const BLOCKS: &[(u32, &str, &[u16])] = &["]
    for first, name, ids in rows:
        lines.append(f"    ({first}, {json.dumps(name)}, &[{', '.join(str(i) for i in ids)}]),")
    lines.append("];")
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text("\n".join(lines) + "\n", encoding="utf-8", newline="\n")
    print(f"{len(rows)} blocks, {total} states, {len(properties)} properties -> {OUT.relative_to(ROOT)}")


main()
