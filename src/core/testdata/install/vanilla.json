{
  "id": "26.3",
  "type": "release",
  "mainClass": "net.minecraft.client.main.Main",
  "javaVersion": { "component": "java-runtime-epsilon", "majorVersion": 25 },
  "assetIndex": { "id": "34", "sha1": "e99f9973047785b5a9d52eaf72020b97545053c9", "size": 597235, "url": "https://example.invalid/34.json" },
  "downloads": { "client": { "sha1": "e877b6a07acd633fb3bb475002175cec036e7b87", "size": 41483720, "url": "https://example.invalid/client.jar" } },
  "logging": { "client": { "argument": "-Dlog4j.configurationFile=${path}", "file": { "id": "client-1.21.2.xml", "sha1": "39384bd14c0606d812afec88d8aff595b2587dd9", "size": 1073, "url": "https://example.invalid/client.xml" } } },
  "arguments": {
    "default-user-jvm": [{ "value": ["-Xms2G", "-Xmx4G"] }],
    "jvm": [
      { "rules": [{ "action": "allow", "os": { "name": "osx" } }], "value": ["-XstartOnFirstThread"] },
      { "rules": [{ "action": "allow", "os": { "name": "windows" } }], "value": "-XX:HeapDumpPath=dump.heapdump" },
      { "rules": [{ "action": "allow", "os": { "arch": "x86" } }], "value": "-Xss1M" },
      "-Djava.library.path=${natives_directory}/java",
      "-Dminecraft.launcher.brand=${launcher_name}",
      "-Dminecraft.launcher.version=${launcher_version}",
      "-cp",
      "${classpath}"
    ],
    "game": [
      "--username", "${auth_player_name}",
      "--version", "${version_name}",
      "--gameDir", "${game_directory}",
      "--assetsDir", "${assets_root}",
      "--assetIndex", "${assets_index_name}",
      "--uuid", "${auth_uuid}",
      "--accessToken", "${auth_access_token}",
      "--clientId", "${clientid}",
      "--xuid", "${auth_xuid}",
      "--versionType", "${version_type}",
      { "rules": [{ "action": "allow", "features": { "is_demo_user": true } }], "value": "--demo" },
      { "rules": [{ "action": "allow", "features": { "has_custom_resolution": true } }], "value": ["--width", "${resolution_width}", "--height", "${resolution_height}"] },
      { "rules": [{ "action": "allow", "features": { "has_quick_plays_support": true } }], "value": ["--quickPlayPath", "${quickPlayPath}"] },
      { "rules": [{ "action": "allow", "features": { "is_quick_play_multiplayer": true } }], "value": ["--quickPlayMultiplayer", "${quickPlayMultiplayer}"] }
    ]
  },
  "libraries": [
    { "name": "org.ow2.asm:asm:9.9", "downloads": { "artifact": { "path": "org/ow2/asm/asm/9.9/asm-9.9.jar", "sha1": "11", "size": 1, "url": "https://libraries.minecraft.net/org/ow2/asm/asm/9.9/asm-9.9.jar" } } },
    { "name": "org.lwjgl:lwjgl:3.4.3", "downloads": { "artifact": { "path": "org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3.jar", "sha1": "12", "size": 2, "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3.jar" } } },
    { "name": "org.lwjgl:lwjgl:3.4.3:natives-linux", "rules": [{ "action": "allow", "os": { "name": "linux" } }], "downloads": { "artifact": { "path": "org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-linux.jar", "sha1": "13", "size": 3, "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-linux.jar" } } },
    { "name": "org.lwjgl:lwjgl:3.4.3:natives-macos", "rules": [{ "action": "allow", "os": { "name": "osx" } }], "downloads": { "artifact": { "path": "org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-macos.jar", "sha1": "14", "size": 4, "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-macos.jar" } } },
    { "name": "org.lwjgl:lwjgl:3.4.3:natives-windows", "rules": [{ "action": "allow", "os": { "name": "windows" } }], "downloads": { "artifact": { "path": "org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-windows.jar", "sha1": "15", "size": 5, "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-windows.jar" } } },
    { "name": "org.lwjgl:lwjgl:3.4.3:natives-windows-arm64", "rules": [{ "action": "allow", "os": { "name": "windows" } }], "downloads": { "artifact": { "path": "org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-windows-arm64.jar", "sha1": "16", "size": 6, "url": "https://libraries.minecraft.net/org/lwjgl/lwjgl/3.4.3/lwjgl-3.4.3-natives-windows-arm64.jar" } } },
    { "name": "ca.weblite:java-objc-bridge:1.1", "rules": [{ "action": "allow", "os": { "name": "osx" } }], "downloads": { "artifact": { "path": "ca/weblite/java-objc-bridge/1.1/java-objc-bridge-1.1.jar", "sha1": "17", "size": 7, "url": "https://libraries.minecraft.net/ca/weblite/java-objc-bridge/1.1/java-objc-bridge-1.1.jar" } } },
    {
      "name": "legacy:legacy-platform:1.0",
      "natives": { "linux": "natives-linux", "osx": "natives-osx", "windows": "natives-windows-${arch}" },
