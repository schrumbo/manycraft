          "natives-windows-64": { "path": "legacy/legacy-platform/1.0/legacy-platform-1.0-natives-windows-64.jar", "sha1": "1b", "size": 11, "url": "https://libraries.minecraft.net/legacy/legacy-platform/1.0/legacy-platform-1.0-natives-windows-64.jar" }
        }
      }
    }
  ]
